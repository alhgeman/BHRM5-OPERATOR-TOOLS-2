-- ============ ADD / REMOVE ============
local removeNPC, addNPC, tryAddLater
tryAddLater = function(model, tries)
    if state.unloaded or npcMap[model] then return end
    if not model or not model.Parent then return end
    tries = tries or 0
    if tries > 6 then return end
    local ok, res = pcall(isNPC, model)
    if ok and res then addNPC(model)
    elseif model.Parent then task.delay(0.5, function() tryAddLater(model, tries + 1) end) end
end
addNPC = function(model)
    if state.unloaded or npcMap[model] or not model.Parent then return end
    if not isNPC(model) then return end
    local root, head = getNpcRoot(model), getNpcHead(model)
    if not root or not head then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local data = { root = root, head = head, hum = hum, conn = nil, ancestryConn = nil }
    npcMap[model] = data
    if state.wallEsp then
        local box = makeBox(head)
        if box then boxMap[head] = box end
    end
    if hum then
        data.conn = track(hum.Died:Connect(function() removeNPC(model) end))
    end
    local c
    c = track(model.AncestryChanged:Connect(function(_, parent)
        if parent == nil then
            if c then pcall(function() c:Disconnect() end) end
            removeNPC(model)
        end
    end))
    data.ancestryConn = c
end
removeNPC = function(model)
    if not model then return end
    local d = npcMap[model]
    npcMap[model] = nil
    if d then
        if d.head then
            pcall(function()
                local b = d.head:FindFirstChild("WallBox")
                if b then b:Destroy() end
            end)
            boxMap[d.head] = nil
        end
        if d.conn then pcall(function() d.conn:Disconnect() end) end
        if d.ancestryConn then pcall(function() d.ancestryConn:Disconnect() end) end
        if cachedTarget and (cachedTarget == d.head or cachedTarget == d.root) then cachedTarget = nil end
    end
end
local function scanNPCs()
    if state.unloaded then return end
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("Model") and desc.Name == "Male" and not npcMap[desc] then
            local ok, res = pcall(isNPC, desc)
            if ok and res then pcall(addNPC, desc) end
        end
    end
end

