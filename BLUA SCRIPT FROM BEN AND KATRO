local function makeBtn(text, color, icon)
    local b = Instance.new("TextButton", cont)
    b.Size = UDim2.new(1, 0, 0, 34)
    b.Text = (icon and icon .. " " or "") .. text
    b.BackgroundColor3 = color
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local function onHover()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = color:Lerp(Color3.new(1,1,1), 0.2)}):Play()
    end
    local function onLeave()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = color}):Play()
    end
    b.MouseEnter:Connect(onHover)
    b.MouseLeave:Connect(onLeave)
    return b
end

