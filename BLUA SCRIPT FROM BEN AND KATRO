-- ============ NPC ============
local function getNpcHead(m) return m:FindFirstChild("Head") or m:FindFirstChild("FakeHead") end
local function getNpcRoot(m) return m:FindFirstChild("Root") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("LowerTorso") end
local function isNPC(model)
    if state.unloaded then return false end
    if not model or not model:IsA("Model") then return false end
    if model.Name ~= "Male" then return false end
    local char = plr.Character
    if char then
        if model == char then return false end
        local ok, isDesc = pcall(function() return model:IsDescendantOf(char) end)
        if ok and isDesc then return false end
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    local head, root = getNpcHead(model), getNpcRoot(model)
    if not head or not root then return false end
    if not head:IsA("BasePart") or not root:IsA("BasePart") then return false end
    return true
end
local function countNPCs()
    local c = 0
    for _ in pairs(npcMap) do c += 1 end
    return c
end

-- ============ WALL ESP (boxes on npc heads, green = visible / red = behind wall) ============
local function makeBox(part)
    if not part or not part.Parent then return nil end
    local old = part:FindFirstChild("WallBox")
    if old then return old end
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "WallBox"
    box.Size = part.Size + Vector3.new(0.6, 0.6, 0.6)
    box.Adornee = part
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Color3 = Color3.fromRGB(255, 60, 60)
    box.Transparency = 0.35
    box.Parent = part
    return box
end
local function killAllBoxes()
    for adorned, box in pairs(boxMap) do
        pcall(function() if box and box.Parent then box:Destroy() end end)
        if adorned and adorned.Parent then
            pcall(function()
                local b = adorned:FindFirstChild("WallBox")
                if b then b:Destroy() end
            end)
        end
    end
    table.clear(boxMap)
    for model in pairs(npcMap) do
        pcall(function()
            for _, d in ipairs(model:GetDescendants()) do
                if d.Name == "WallBox" and d:IsA("BoxHandleAdornment") then d:Destroy() end
            end
        end)
    end
end
local function refreshBoxes()
    killAllBoxes()
    if not state.wallEsp then return end
    for model in pairs(npcMap) do
        local d = npcMap[model]
        if d and d.head and d.head.Parent then
            local box = makeBox(d.head)
            if box then boxMap[d.head] = box end
        end
    end
end

