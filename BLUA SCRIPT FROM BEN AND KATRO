local function countNPCs()
    local c = 0
    for _ in pairs(npcMap) do c = c + 1 end
    return c
end

local function getNpcHead(model)
    return model:FindFirstChild("FakeHead")
end

local function getNpcRoot(model)
    return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Root")
end

local function isNPC(model)
    if not model or not model:IsA("Model") then return false end
    if plr.Character and (model == plr.Character or model:IsDescendantOf(plr.Character)) then
        return false
    end
    if model.Name ~= "Male" then return false end
    local parent = model.Parent
    if not parent or parent.Name ~= "Model" then return false end
    local head = model:FindFirstChild("FakeHead")
    local root = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Root")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        return false
    end
    return head and root ~= nil
end

local removeNPC
local addNPC

local function findAllNPCs()
    local npcs = {}
    local function search(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if isNPC(child) then
                table.insert(npcs, child)
            end
            search(child)
        end
    end
    search(Workspace)
    return npcs
end

local function scanNPCs()
    local npcs = findAllNPCs()
    for _, npc in ipairs(npcs) do
        addNPC(npc)
    end
end

local function makeBox(part)
    if not part or not part.Parent then return nil end
    if part:FindFirstChild("WallBox") then return part.WallBox end
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "WallBox"
    box.Size = part.Size + Vector3.new(0.5, 0.5, 0.5)
    box.Adornee = part
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Color3 = Color3.fromRGB(255, 0, 0)
    box.Transparency = 0.3
    box.Parent = part
    return box
end

local function killBox(part)
    if not part then return end
    local box = part:FindFirstChild("WallBox")
    if box then box:Destroy() end
end

local function killAllBoxes()
    for head, box in pairs(boxMap) do
        if box and box.Parent then box:Destroy() end
    end
    boxMap = {}
end

local function refreshBoxes()
    killAllBoxes()
    if not state.wallEsp then return end
    for model in pairs(npcMap) do
        local head = getNpcHead(model)
        if head then
            local box = makeBox(head)
            if box then boxMap[head] = box end
        end
    end
end

local function applyHitboxAndESP()
    for model in pairs(npcMap) do
        local root = getNpcRoot(model)
        if root then
            if not origSizes[model] then origSizes[model] = root.Size end
            if origTrans[model] == nil then origTrans[model] = root.Transparency end
            if state.hitbox then
                root.Size = Vector3.new(20, 20, 20)
                root.CanCollide = false
                root.Transparency = state.npcEsp and 0.8 or origTrans[model]
            else
                if origSizes[model] then root.Size = origSizes[model] end
                root.Transparency = state.npcEsp and 0.8 or origTrans[model]
            end
        end
    end
end

local function resetAllSizes()
    for model in pairs(npcMap) do
        local root = getNpcRoot(model)
        if root then
            if origSizes[model] then root.Size = origSizes[model] end
            root.Transparency = origTrans[model] or 0
        end
    end
    origSizes = {}
    origTrans = {}
end

local origLight = {
    Ambient = Lighting.Ambient,
    Brightness = Lighting.Brightness,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    FogEnd = Lighting.FogEnd,
    FogStart = Lighting.FogStart,
    GlobalShadows = Lighting.GlobalShadows,
}

local function applyFB()
    if state.unloaded then return end
    Lighting.Ambient = Color3.new(1, 1, 1)
    Lighting.Brightness = 10
    Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    Lighting.FogEnd = 100000
    Lighting.FogStart = 0
    Lighting.GlobalShadows = false
end

local function restoreFB()
    for k, v in pairs(origLight) do
        Lighting[k] = v
    end
end

local status

local lastCamPos = cam.CFrame.Position
local raycastCooldown = 0

local function onRender(dt)
    if state.unloaded then return end
    for model in pairs(npcMap) do
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not model.Parent or (hum and hum.Health <= 0) then
            removeNPC(model)
            if status then status.Text = "◆ " .. countNPCs() .. " NPCs geladen" end
        end
    end
    raycastCooldown = raycastCooldown - dt
    local camPos = cam.CFrame.Position
    if state.wallEsp and (raycastCooldown <= 0 or (camPos - lastCamPos).Magnitude > 1) then
        raycastCooldown = 0.1
        lastCamPos = camPos
        local origin = cam.CFrame.Position
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = {plr.Character}
        for head, box in pairs(boxMap) do
            if head and head.Parent and box and box.Parent then
                params.FilterDescendantsInstances[2] = head
                local result = Workspace:Raycast(origin, head.Position - origin, params)
                local visible = not result or result.Instance:IsDescendantOf(head.Parent)
                box.Color3 = visible and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
            else
                boxMap[head] = nil
            end
        end
    end
    if state.hitbox or state.npcEsp then
        applyHitboxAndESP()
    end
end

addNPC = function(model)
    if not model or not model.Parent then return end
    if npcMap[model] then return end
    if not isNPC(model) then return end
    npcMap[model] = true
    local root = getNpcRoot(model)
    if root then
        if not origSizes[model] then origSizes[model] = root.Size end
        if origTrans[model] == nil then origTrans[model] = root.Transparency end
        if state.hitbox then
            root.Size = Vector3.new(12, 12, 12)
            root.CanCollide = false
            root.Transparency = state.npcEsp and 0.8 or origTrans[model]
        elseif state.npcEsp then
            root.Transparency = 0.8
        end
    end
    if state.wallEsp then
        local head = getNpcHead(model)
        if head then
            local box = makeBox(head)
            if box then boxMap[head] = box end
        end
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.HealthChanged:Connect(function(health)
            if health <= 0 then
                removeNPC(model)
                if status then status.Text = "◆ " .. countNPCs() .. " NPCs geladen" end
            end
        end)
    end
end

removeNPC = function(model)
    if not model then return end
    npcMap[model] = nil
    local head = getNpcHead(model)
    if head then killBox(head) end
    local root = getNpcRoot(model)
    if root then
        if origSizes[model] and root.Parent then
            pcall(function()
                root.Size = origSizes[model]
                root.CanCollide = true
                root.Transparency = origTrans[model] or 0
            end)
        end
    end
    origSizes[model] = nil
    origTrans[model] = nil
end

