-- ============ SILENT AIM (cached @10Hz) ============
local aimHooked, aimOrigMuzzle, aimMod = false, nil, nil
cachedTarget = nil
local cachedTargetPos, cachedWalled, lastTargetPick = nil, false, 0
local sharedParams = RaycastParams.new()
sharedParams.FilterType = Enum.RaycastFilterType.Exclude
sharedParams.IgnoreWater = true

local function pickTarget()
    if not state.silentAim or state.unloaded then
        cachedTarget, cachedTargetPos, cachedWalled = nil, nil, false
        return
    end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local best, bestPos, bestDist, bestWalled = nil, nil, state.fovRadius, false
    sharedParams.FilterDescendantsInstances = { plr.Character, cam }
    for model, d in pairs(npcMap) do
        local part = (state.aimPart == "Head" and d.head) or d.root
        if part and part.Parent then
            local ok, sp, onScreen = pcall(function() return cam:WorldToViewportPoint(part.Position) end)
            if ok and onScreen then
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if dist < bestDist then
                    local dir = part.Position - cam.CFrame.Position
                    local res = Workspace:Raycast(cam.CFrame.Position, dir, sharedParams)
                    local walled = res and res.Instance and not res.Instance:IsDescendantOf(model)
                    if state.wallbang or not walled then
                        best, bestPos, bestDist, bestWalled = part, part.Position, dist, walled and true or false
                    end
                end
            end
        end
    end
    cachedTarget, cachedTargetPos, cachedWalled = best, bestPos, bestWalled
    lastTargetPick = os.clock()
end

hookSilentAim = function()
    if aimHooked then return true end
    local gni = getnilinstances or get_nil_instances
    if not gni then return false end
    local mod = nil
    for _, v in next, gni() do
        if v.Name == "FirearmInventory" and v:IsA("ModuleScript") then mod = v break end
    end
    if not mod then return false end
    local ok, req = pcall(require, mod)
    if not ok or not req or not req.GetMuzzleCFrame then return false end
    aimMod, aimOrigMuzzle = req, req.GetMuzzleCFrame
    local orig = aimOrigMuzzle
    req.GetMuzzleCFrame = function(self, ...)
        local mn = select("#", ...)
        local okM, mz
        if mn > 0 then
            local a = { ... }
            okM, mz = pcall(function() return orig(self, unpack(a, 1, mn)) end)
        else
            okM, mz = pcall(function() return orig(self) end)
        end
        if not okM or not mz then
            if mn > 0 then return orig(self, ...) else return orig(self) end
        end
        if os.clock() - lastTargetPick > 0.1 or (cachedTarget and not cachedTarget.Parent) then pickTarget() end
        if cachedTarget and cachedTarget.Parent then
            local aimAt = cachedTargetPos
            if state.aimPart == "Head" then aimAt = aimAt + Vector3.new(0, 0.15, 0) end
            local origin = mz.Position
            if state.wallbang and cachedWalled then
                local toT = aimAt - origin
                local dist = toT.Magnitude
                if dist > 4 then
                    origin = origin + toT.Unit * math.min(15, dist - 1)
                end
            end
            return CFrame.lookAt(origin, aimAt)
        end
        return mz
    end
    aimHooked = true
    return true
end
unhookSilentAim = function()
    if aimMod and aimOrigMuzzle then pcall(function() aimMod.GetMuzzleCFrame = aimOrigMuzzle end) end
    aimHooked, aimOrigMuzzle, aimMod = false, nil, nil
    cachedTarget, cachedTargetPos, cachedWalled = nil, nil, false
end

