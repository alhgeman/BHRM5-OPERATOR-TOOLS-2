-- ============ MAIN LOOP ============
scanNPCs()

local lastRay, lastStatus, lastCamPos = 0, 0, cam.CFrame.Position
local fpsAcc, fpsN, fpsShow = 0, 0, 60
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

renderConn = RunService.RenderStepped:Connect(function(dt)
    if state.unloaded then return end
    local now = os.clock()
    fpsAcc += dt; fpsN += 1
    if fpsAcc >= 0.5 then fpsShow = math.floor(fpsN / fpsAcc + 0.5) fpsAcc, fpsN = 0, 0 end
    for model, d in pairs(npcMap) do
        if (not model.Parent) or (d.hum and d.hum.Health <= 0) or (d.root and not d.root.Parent) then
            removeNPC(model)
        end
    end
    if state.silentAim and now - lastTargetPick > 0.1 then pickTarget() end
    local camPos = cam.CFrame.Position
    if state.wallEsp and (now - lastRay > 0.25 or (camPos - lastCamPos).Magnitude > 2) then
        lastRay = now; lastCamPos = camPos
        rayParams.FilterDescendantsInstances = { plr.Character, cam }
        local n = 0
        for adorned, box in pairs(boxMap) do
            n += 1
            if n > 10 then break end
            if adorned and adorned.Parent and box and box.Parent then
                local dir = adorned.Position - camPos
                if dir.Magnitude > 5 then
                    local ok, result = pcall(function() return Workspace:Raycast(camPos, dir, rayParams) end)
                    local visible = true
                    if ok and result and result.Instance then
                        visible = result.Instance:IsDescendantOf(adorned.Parent)
                    end
                    box.Color3 = visible and Color3.fromRGB(40, 255, 130) or Color3.fromRGB(255, 60, 60)
                end
            else
                boxMap[adorned] = nil
            end
        end
    end
    if now - lastStatus > 0.5 then
        lastStatus = now
        local flags = {}
        if state.fullBright then table.insert(flags, "FB") end
        if state.wallEsp then table.insert(flags, "ESP") end
        if state.silentAim then table.insert(flags, "AIM:" .. state.aimPart:sub(1, 1)) end
        if state.wallbang then table.insert(flags, "WB") end
        local n = countNPCs()
        if #flags > 0 then
            status.Text = table.concat(flags, "  •  ")
            status.TextColor3 = TXT
            dot.BackgroundColor3 = Color3.fromRGB(40, 200, 120)
        else
            status.Text = "IDLE"
            status.TextColor3 = DIM
            dot.BackgroundColor3 = Color3.fromRGB(60, 70, 95)
        end
        statNpc.Text = n .. " NPC"
        statFps.Text = fpsShow .. " FPS"
        statFps.TextColor3 = fpsShow >= 55 and Color3.fromRGB(40, 200, 120)
            or (fpsShow >= 30 and Color3.fromRGB(255, 190, 60) or Color3.fromRGB(255, 90, 90))
    end
    if fovCircle then
        local ok = pcall(function()
            fovCircle.Visible = state.silentAim and state.showFov and not state.unloaded
            fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
            fovCircle.Radius = state.fovRadius
            fovCircle.Color = state.wallbang and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(0, 210, 255)
        end)
        if not ok then fovCircle = nil end
    end
end)

